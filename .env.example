# Every environment variable this project needs, listed by name, with no values.
#
# Copy this file and fill in the real values:
#
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This file IS committed, and is
# the only record of what a fresh machine needs in order to run the stack.
#
# Rule: any increment that introduces a new variable adds its name here in the
# same commit that introduces it.
#
# Required variables are uncommented with empty values - fill them in.
# Optional ones are COMMENTED OUT, showing their default. Leave them commented to
# use the default. Never uncomment one and leave it empty: `PORT=` sets PORT to
# "", which is not the same as unset, and the API refuses to start.


# --- Postgres (increment 1.2) -------------------------------------------------
# Read by docker-compose.yml. These three create the database on the volume's
# FIRST start only. Changing them afterwards has no effect until the volume is
# destroyed with `docker compose down -v`.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# How code running ON THE VM reaches that database: `pnpm --filter api start:dev`
# and every Prisma command. Must agree with the three above. Host is localhost
# because the postgres container publishes 5432 to the VM.
#
# The containers do not use this value: docker-compose.yml builds their own URL
# from the three above, with the service name `postgres` as the host - inside a
# container, localhost is the container itself.
#
#   postgresql://USER:PASSWORD@localhost:5432/DB?schema=public

DATABASE_URL=


# --- API (increment 1.3b) -----------------------------------------------------
# Validated at boot by apps/api/src/config/env.validation.ts. The commented ones
# below have defaults there; DATABASE_URL above and JWT_SECRET do not - their
# absence stops the process before a port is bound.

# development | production | test. For start:dev on the VM. The api CONTAINER
# always runs as production - docker-compose.yml sets it, whatever this says.
# NODE_ENV=development

# 1-65535.
# PORT=3000

# error, warn, info, debug, trace, silent, fatal - pino's levels.
# LOG_LEVEL=info

# Signs and verifies JWTs. NO DEFAULT - the API refuses to start without it,
# and that is the point: a fallback secret would sit in this public repo and let
# anyone forge a token for any user, while the app booted perfectly happily.
# Minimum 32 characters. Generate it, never invent one:
#
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=

# How long an access token stays valid. A number followed by a unit - s, m, h,
# d, w, y. For example: 30s, 15m, 2h.
#
# Short on purpose. A JWT cannot be revoked, so this window is exactly how long
# a stolen token keeps working.
# JWT_ACCESS_TTL=15m

# How long a refresh token stays valid. A number followed by a unit - s, m, h,
# d, w, y. For example: 12h, 7d, 30d.
#
# Long on purpose, and safe to be long because a refresh token CAN be revoked -
# it is a row in the database, unlike an access token.
#
# This is an IDLE timeout, not a session limit: every refresh issues a new token
# with a fresh 7 days, so an active user is never logged out.
# JWT_REFRESH_TTL=7d

# --- CORS (increment 1.6b) ----------------------------------------------------
# The single origin allowed to read API responses from a browser, cross-origin.
# Since ADR 0010 the browser reaches the API on its own origin (Vite's proxy,
# nginx), so CORS is a fallback; the default is the Vite dev server.
#
# An ORIGIN, not a URL: scheme://host[:port], nothing after it. No trailing
# slash - browsers never send one, so it would never match.
#
# The default fails closed: forget this in production and the deployed frontend
# is refused, visibly. That is deliberate - see env.validation.ts.
#
# CORS protects USERS from other sites using their credentials. It does not
# protect the API from anyone calling it directly; authentication does that.
# WEB_ORIGIN=http://localhost:5173

# Secure attribute on the auth cookies. Defaults to true; ONLY the exact string
# "false" turns it off - leave it commented anywhere but a local .env. Set COOKIE_SECURE=false in a local .env if you use
# httpyac: its cookie jar follows RFC 6265 strictly and will not send a Secure
# cookie over plain http, even to localhost. Browsers do not need this.
# Never set it in a deployed environment.
# COOKIE_SECURE=false   (the default is true; this line is the local opt-out, not the default)
