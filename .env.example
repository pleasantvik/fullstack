# Every environment variable this project needs, listed by name, with no values.
#
# Copy this file and fill in the real values:
#
#     cp .env.example .env
#
# .env is gitignored and must never be committed. This file IS committed, and is
# the only record of what a fresh machine needs in order to run the stack.
#
# Rule: any increment that introduces a new variable adds its name here in the
# same commit that introduces it.


# --- Postgres (increment 1.2) -------------------------------------------------
# Read by docker-compose.yml. These three create the database on the volume's
# FIRST start only. Changing them afterwards has no effect until the volume is
# destroyed with `docker compose down -v`.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# How application code reaches that database. Must agree with the three above.
#
# Host is `localhost` because the app runs in the VM alongside the container,
# which publishes 5432. Once the API itself is containerised in 1.7, code
# running inside another container reaches it as `postgres` - the service name -
# not localhost.
#
#   postgresql://USER:PASSWORD@localhost:5432/DB?schema=public

DATABASE_URL=


# --- API (increment 1.3b) -----------------------------------------------------
# Validated at boot by apps/api/src/config/env.validation.ts. Both of these have
# defaults in that schema, so the API starts without them. DATABASE_URL above
# does not - its absence stops the process before a port is bound.

# development | production | test
NODE_ENV=

# 1-65535. Defaults to 3000.
PORT=

# error, warn, info, debug, trace, silent, fatal. pino's levels for logs
LOG_LEVEL=
