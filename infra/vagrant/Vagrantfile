# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Local development VM for task-manager.
#
# Docker runs inside this VM rather than on Windows via Docker Desktop, because
# Docker Desktop requires Hyper-V, and Hyper-V degrades the VirtualBox VMs used
# elsewhere on this machine. See docs/decisions/0002-local-dev-in-a-vagrant-vm.md
#
# Usage:
#   cd infra/vagrant
#   vagrant up
#   vagrant ssh

Vagrant.configure("2") do |config|
  # Pinned. An unpinned box silently changes under you between rebuilds, which
  # defeats the point of being able to destroy and recreate.
  config.vm.box         = "ubuntu/jammy64"
  config.vm.box_version = "20241002.0.0"
  config.vm.hostname    = "task-manager-dev"

  # NO host-only network, deliberately.
  #
  # A second adapter was configured here (private_network, 192.168.56.20) and it
  # hung the guest on boot, twice, at exactly the same point: immediately after
  # the kernel renamed eth1 (PCI slot 8, the host-only NIC) to enp0s8. Same stall
  # both times, so a cause rather than a race.
  #
  # It is not needed. Everything is reachable over the forwarded ports below.
  # Do not add it back without a reason that survives a boot test.

  # Forwarded ports, bound to loopback only so nothing is exposed to the
  # local network.
  config.vm.network "forwarded_port", guest: 5432, host: 5432, host_ip: "127.0.0.1"  # postgres
  config.vm.network "forwarded_port", guest: 3000, host: 3000, host_ip: "127.0.0.1"  # api
  config.vm.network "forwarded_port", guest: 5173, host: 5173, host_ip: "127.0.0.1"  # vite

  # The code lives in the VM at ~/task-manager, cloned from GitHub. The default
  # share is disabled so there is no second, slower copy to edit by mistake.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "task-manager-dev"
    vb.memory = 4096   # raise to 6144-8192 at Milestone 4: two API instances,
    vb.cpus   = 2      # redis, worker, prometheus and grafana all run together
  end

  # Runs once on first `vagrant up`. Re-run later with `vagrant provision`.
  config.vm.provision "shell", path: "provision.sh"
end
