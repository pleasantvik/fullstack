# Vagrant local machine state - VM ids and metadata, per-machine, never shared
.vagrant/

# Dependencies
node_modules/
.pnpm-store/

# Environment — .env.* is ignored, then .env.example is explicitly rescued.
# Order matters: the negation must come after the pattern it overrides.
.env
.env.*
!.env.example

# Build output
dist/
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test output
coverage/

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
