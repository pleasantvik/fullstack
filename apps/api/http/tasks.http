# Task requests.
#
#   pnpm exec httpyac send apps/api/http/tasks.http --all
#
# Requires the API running and a registered ada@example.com (see auth.http).
#
# Auth rides in httpOnly cookies, which httpyac's jar sends automatically - so
# no request sets an Authorization header. The jar holds ONE identity for
# localhost, so switching user means logging in again, exactly as in a browser.

# Routes live under /api (ADR 0010); health deliberately does not.
@origin = http://localhost:3000
@host = {{origin}}/api
@email = ada@example.com
@password = correct-horse-battery

###
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

###
# Create a task. 201. The response carries a userId the client never sent.
# @name create
POST {{host}}/tasks
Content-Type: application/json

{
  "title": "Write the 1.5 increment note",
  "description": "What was built, what broke, what I would do differently.",
  "priority": "HIGH",
  "dueDate": "2026-10-13T17:00:00.000Z"
}

###
# Defaults come from the database, not the client: status TODO, priority MEDIUM.
POST {{host}}/tasks
Content-Type: application/json

{ "title": "A task with nothing but a title" }

###
# A smuggled userId -> 400 "property userId should not exist" (ADR 0009).
# Before, whitelist stripped it and the task was created as the caller's; the
# service still spreads the guard's userId last, as a second line of defence.
POST {{host}}/tasks
Content-Type: application/json

{
  "title": "Trying to plant this on someone else",
  "userId": "00000000-0000-0000-0000-000000000000"
}

###
# No title -> 400 from the ValidationPipe, before the service runs.
POST {{host}}/tasks
Content-Type: application/json

{ "description": "A description and no title" }

###
# List. 200 with items, total, page, limit, pages. Only this user's tasks.
GET {{host}}/tasks

###
# Paging works and the totals agree with the rows.
GET {{host}}/tasks?page=1&limit=2

###
# limit above the ceiling -> 400. Without Max(100), this is a one-request way
# to make the database read the whole table.
GET {{host}}/tasks?limit=1000000

###
# No cookies -> 401. These routes were never marked @Public, so the global
# guard from 1.4c closed them without anyone deciding to.
# @no-cookie-jar
GET {{host}}/tasks

###
# Read one. 200. {{create.id}} comes from the create request above.
GET {{host}}/tasks/{{create.id}}

###
# Partial update. 200, with only the named fields changed and updatedAt bumped.
PATCH {{host}}/tasks/{{create.id}}
Content-Type: application/json

{ "status": "IN_PROGRESS" }

###
# A field the API does not have -> 400 "property done should not exist".
# The bug that led to ADR 0009: this used to answer 200 and change nothing.
PATCH {{host}}/tasks/{{create.id}}
Content-Type: application/json

{ "done": true }

###
# Nothing to update -> 400 "Send at least one field to update."
PATCH {{host}}/tasks/{{create.id}}
Content-Type: application/json

{}

###
# A well-formed id that does not exist -> 404.
GET {{host}}/tasks/00000000-0000-0000-0000-000000000000

###
# A malformed id -> 400 from ParseUUIDPipe, before anything reaches Postgres.
GET {{host}}/tasks/banana

###
# Delete. 204, no body.
DELETE {{host}}/tasks/{{create.id}}

###
# Deleting it again -> 404. Same answer as "never existed", and as "belongs to
# someone else". The query cannot tell them apart, which is the point.
DELETE {{host}}/tasks/{{create.id}}

###
# --- Ownership -------------------------------------------------------------
# The rest of this file proves tasks are scoped to their owner. 409 on the
# register is fine after the first run.
# @name registerGrace
POST {{host}}/auth/register
Content-Type: application/json

{ "name": "Grace Hopper", "email": "grace@example.com", "password": "correct-horse-battery" }

###
# @name graceLogin
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "grace@example.com", "password": "correct-horse-battery" }

###
# Grace creates a task. 201.
# @name graceTask
POST {{host}}/tasks
Content-Type: application/json

{ "title": "Grace's task, not Ada's" }

###
# Back to Ada. Grace's login REPLACED Ada's cookies in the jar - so without this,
# the next request would be Grace asking for her own task, return 200, and prove
# nothing. Cookie auth holds one identity per domain; bearer tokens did not.
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

###
# Ada asks for Grace's task BY ITS REAL ID -> 404.
#
# The id is correct and the task exists. Ada is fully authenticated. She is not
# refused by a check - the row is never selected, because userId is in the where
# clause. And the 404 does not confirm the id is real.
GET {{host}}/tasks/{{graceTask.id}}

###
# Ada lists her tasks -> Grace's is absent. Not filtered out. Never selected.
GET {{host}}/tasks

###
# --- Filtering -------------------------------------------------------------
# An overdue task to filter for: due in the past, not DONE.
# @name overdueTask
POST {{host}}/tasks
Content-Type: application/json

{ "title": "Renew the domain", "dueDate": "2026-01-01T00:00:00.000Z" }

###
# By status. Uses both columns of the (userId, status) index.
GET {{host}}/tasks?status=TODO

###
# By priority. Only userId comes from the index here; priority is filtered after.
GET {{host}}/tasks?priority=HIGH

###
# Search, deliberately in the wrong case. mode: "insensitive" -> ILIKE, which
# no B-tree index can help with. Milestone 5 is where that gets fixed properly.
GET {{host}}/tasks?search=RENEW

###
# Overdue: dueDate in the past AND status not DONE. Should contain the task
# created above and nothing with a future or absent due date.
GET {{host}}/tasks?overdue=true

###
# overdue=false must NOT filter. With @Type(() => Boolean) this would have
# returned only overdue tasks, because Boolean("false") is true.
GET {{host}}/tasks?overdue=false

###
# Contradictory filters -> 0 items. Done and not-done is empty, not "one of
# these quietly wins".
GET {{host}}/tasks?status=DONE&overdue=true

###
# An invalid enum value -> 400, naming the allowed values.
GET {{host}}/tasks?status=BANANA

###
# Filters combine with paging, and total reflects the filter, not the table.
GET {{host}}/tasks?status=TODO&page=1&limit=2

###
# --- Health ----------------------------------------------------------------
# Liveness. No token, no database. 200 as long as the process can respond.
GET {{origin}}/health

###
# Readiness. 200 while Postgres is reachable, 503 when it is not.
#
# Try it: `docker compose stop postgres`, run this (503), then
# `docker compose start postgres` and run it again (200). /health above stays
# 200 throughout - which is exactly why a restarter must point at it and not
# at this one.
GET {{origin}}/health/ready
