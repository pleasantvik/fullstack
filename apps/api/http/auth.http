# Auth module requests.
#
#   pnpm exec httpyac send apps/api/http/auth.http --all
#
# Tokens travel only in httpOnly cookies, which httpyac's cookie jar stores and
# sends automatically - the same thing a browser does. No request below sets an
# Authorization header, and no response body ever contains a token.
#
# The jar holds ONE identity for localhost. Logging in replaces whoever was
# logged in before, exactly as in a browser.

@host = http://localhost:3000
@email = ada@example.com
@password = correct-horse-battery

###
# Create the account. 201 with id, email, name and createdAt - no passwordHash.
# 409 after the first run, which is itself the next test.
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# Same email again -> 409.
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# Too short -> 400 from the ValidationPipe, before anything is hashed.
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Grace Hopper",
  "email": "grace@example.com",
  "password": "short"
}

###
# A smuggled field -> 201, isAdmin silently stripped by whitelist: true.
POST {{host}}/auth/register
Content-Type: application/json

{
  "name": "Grace Hopper",
  "email": "hopper@example.com",
  "password": "{{password}}",
  "isAdmin": true
}

###
# Log in -> 204 and an EMPTY body. Read the Set-Cookie headers instead:
#
#   access_token=...;  Path=/;     HttpOnly; Secure; SameSite=Strict
#   refresh_token=...; Path=/auth; HttpOnly; Secure; SameSite=Strict
#
# If a token ever appears in the body, JavaScript could read it and httpOnly is
# for nothing.
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

###
# Wrong password -> 401.
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "definitely-not-the-password"
}

###
# Unknown email -> 401, byte-for-byte identical to the one above.
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "nobody@example.com",
  "password": "definitely-not-the-password"
}

###
# The current user -> 200. No header: the access cookie from login is sent by
# the jar. If this is a 401, the jar declined to store or send a Secure cookie
# over http - see the note in auth-cookies.ts.
GET {{host}}/auth/me

###
# The same request with the jar switched off -> 401. Proves the guard is
# guarding rather than the route merely working.
# @no-cookie-jar
GET {{host}}/auth/me

###
# Rotate -> 204 and two new Set-Cookie headers. No body.
POST {{host}}/auth/refresh

###
# Still authenticated after rotation, with the new access cookie.
GET {{host}}/auth/me

###
# Log out -> 204. The Set-Cookie headers now clear both cookies: empty values,
# an Expires date in the past, and the SAME paths they were set with - which is
# why auth-cookies.ts uses one options object for setting and clearing.
POST {{host}}/auth/logout

###
# Logged out -> 401. The access cookie is gone from the jar.
GET {{host}}/auth/me

###
# Refresh after logout -> 401. The cookie is gone AND the token behind it was
# revoked server-side - logout did both, which is why it needs a server
# endpoint at all.
POST {{host}}/auth/refresh

###
# Logging out again -> 204, not an error. Logout's job is to leave you logged
# out, and you already are.
POST {{host}}/auth/logout
