# Variables for the web app. Copy to .env:
#
#     cp apps/web/.env.example apps/web/.env
#
# Unlike the root .env.example, values are included. Every VITE_ variable is
# PUBLIC - inlined into the browser bundle as plain text at build time - so
# nothing here is a secret, and a working default saves a step.
#
# Never put a secret in a VITE_ variable. Never add a non-VITE_ variable here
# expecting the browser to see it; Vite deliberately exposes only VITE_*.

# The API as seen from the BROWSER, not from the VM. The browser runs on
# Windows, so this is the Vagrant-forwarded port. Changing it means rebuilding:
# the value is baked in, not read at runtime.
VITE_API_URL=http://localhost:3000
